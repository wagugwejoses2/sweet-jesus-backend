# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file to version control.

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (your website's domain(s)).
# Example: https://sweetjesus.org,https://www.sweetjesus.org
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Database (Supabase) ---
# From your Supabase project: Settings -> API.
# SUPABASE_URL is the "Project URL". SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key (NOT the "anon" public key — the service role
# key bypasses Row Level Security and must never be exposed to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The anon/public key is safe to expose in frontend code, and is what the
# CMS-reading pages (Stories, Resources, homepage impact numbers) will use
# directly from the browser — see cms-client.js.
SUPABASE_ANON_KEY=

# --- Email notifications ---
# If left blank, submissions are still saved to disk but no email is sent.
# Works with any SMTP provider: Gmail (with an app password), SendGrid, Mailgun, Zoho, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where notification emails are sent when a form is submitted.
NOTIFY_EMAIL=hello@sweetjesus.org
# The "from" address emails are sent as (often must match SMTP_USER for many providers).
FROM_EMAIL=no-reply@sweetjesus.org

# --- Safeguarding ---
# A separate, more tightly monitored address for the safeguarding "Report a concern" form.
SAFEGUARDING_EMAIL=safeguarding@sweetjesus.org

# --- Admin access ---
# A long, random string used to view submissions via GET /admin/submissions/:formType.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
